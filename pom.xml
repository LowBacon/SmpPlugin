<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bx</groupId>
    <artifactId>smpplugin</artifactId>
    <version>3.2.0</version>
    <packaging>jar</packaging>

    <name>SmpPlugin</name>
    <description>Complete Minecraft SMP core plugin for Paper, Purpur, Spigot and Bukkit servers.</description>

    <properties>
        <!--
            IMPORTANT:
            Paper hard-forked from Spigot, and their 26.3 APIs are not binary compatible
            (e.g. GameRule is an interface in Spigot but a class in Paper, and some constants
            have different names). A jar compiled against one API can crash on the other.
            So this project builds one jar per API family:

              mvn clean package             -> SmpPlugin-<version>-paper.jar   (Paper and Purpur)
              mvn clean package -Pspigot    -> SmpPlugin-<version>-spigot.jar  (Spigot and CraftBukkit)

            One jar per family runs on Minecraft 1.21.11, 26.1, 26.1.1, 26.1.2, 26.2 and 26.3:
              - it is compiled against the OLDEST supported API (1.21.11) as Java 21 bytecode, because
                1.21.11 servers run on Java 21 while 26.x servers need Java 25 (which runs Java 21
                bytecode fine);
              - plugin.yml declares api-version 1.21, so every one of those servers loads it;
              - CompatibilityPolicy.MINIMUM refuses anything older than 1.21.11 at start-up.
            Newer server API is only ever reached through reflection or a runtime check.

            To prove the code still compiles against the newest API, run:
              mvn clean compile -Ppaper,api-latest        (Paper 26.3, Java 25)
              mvn clean compile -Pspigot,api-latest       (Spigot 26.3, Java 25)

            The plugin's own version (above) is independent of the Minecraft version.
        -->
        <java.version>21</java.version>

        <!-- Lowest Minecraft API this artifact supports; written to plugin.yml api-version. -->
        <minecraft.api.version>1.21</minecraft.api.version>
        <paper-api.version>1.21.11-R0.1-SNAPSHOT</paper-api.version>
        <spigot-api.version>1.21.11-R0.1-SNAPSHOT</spigot-api.version>

        <placeholderapi.version>2.12.2</placeholderapi.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>


    <!-- ========================================================= -->
    <!-- REPOSITORIES                                              -->
    <!-- ========================================================= -->

    <repositories>

        <!-- Spigot API -->
        <repository>
            <id>spigot-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>

            <releases>
                <enabled>false</enabled>
            </releases>

            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>


        <!-- Paper -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>

            <releases>
                <enabled>true</enabled>
            </releases>

            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>


        <!-- ProtocolLib -->
        <repository>
            <id>dmulloy2</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>


        <!-- PlaceholderAPI -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>


        <!-- JitPack -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>


        <!-- LunarClient / Apollo -->
        <repository>
            <id>lunarclient</id>
            <url>https://repo.lunarclient.dev</url>
        </repository>


        <!-- Cumulus mirror. This avoids the unavailable OpenCollab endpoint. -->
        <repository>
            <id>loohp-repo</id>
            <url>https://repo.loohpjames.com/repository</url>
        </repository>

        <!-- SkinsRestorer / CodeMC -->
        <repository>
            <id>codemc</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>

        <!-- FancyNpcs -->
        <repository>
            <id>fancyinnovations</id>
            <name>FancyInnovations Repository</name>
            <url>https://repo.fancyinnovations.com/releases</url>
        </repository>

        <!-- Simple Voice Chat API -->
        <repository>
            <id>maxhenkel</id>
            <name>Max Henkel Repository</name>
            <url>https://maven.maxhenkel.de/repository/public</url>
        </repository>

    </repositories>


    <!-- ========================================================= -->
    <!-- DEPENDENCY MANAGEMENT                                     -->
    <!-- ========================================================= -->

    <dependencyManagement>
        <dependencies>
            <!--
                A provided dependency pulls in byte-buddy 1.15.1, which cannot read Java 25
                class files. Mockito (tests only) needs a current version. Not shaded.
            -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.18.14</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>1.18.14</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <!-- ========================================================= -->
    <!-- DEPENDENCIES                                              -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- SERVER API                                             -->
        <!-- ===================================================== -->

        <!-- Server API: chosen by the paper (default) or spigot profile below. -->
        <dependency>
            <groupId>${server.api.groupId}</groupId>
            <artifactId>${server.api.artifactId}</artifactId>
            <version>${server.api.version}</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- PROTOCOLLIB                                            -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.3.0</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- SKINSRESTORER                                          -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>net.skinsrestorer</groupId>
            <artifactId>skinsrestorer-api</artifactId>
            <version>15.12.0</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- CUMULUS (Bedrock forms) -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.geysermc.cumulus</groupId>
            <artifactId>cumulus</artifactId>
            <version>1.1.2</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- SQLITE                                                  -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
            <scope>compile</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- MYSQL                                                   -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>compile</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- MONGODB                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>5.2.1</version>
            <scope>compile</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- REDIS                                                   -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.2.0</version>
            <scope>compile</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- PLACEHOLDERAPI                                          -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>${placeholderapi.version}</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- ADVENTURE                                               -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.24.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-gson</artifactId>
            <version>4.24.0</version>
            <scope>compile</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- APOLLO                                                  -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.lunarclient</groupId>
            <artifactId>apollo-api</artifactId>
            <version>1.2.5</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- VAULT                                                   -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>

            <exclusions>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


        <!-- ===================================================== -->
        <!-- FANCYNPCS                                               -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>de.oliver</groupId>
            <artifactId>FancyNpcs</artifactId>
            <version>2.9.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===================================================== -->
        <!-- SIMPLE VOICE CHAT (optional, for /vcmute)               -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>de.maxhenkel.voicechat</groupId>
            <artifactId>voicechat-api</artifactId>
            <version>2.6.24</version>
            <scope>provided</scope>
        </dependency>


        <!-- ===================================================== -->
        <!-- TESTING                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Mocks server API types whose abstract methods differ between Paper and Spigot. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ========================================================= -->
    <!-- SERVER API PROFILES                                       -->
    <!-- ========================================================= -->

    <profiles>

        <!-- Default: Paper API. Use this jar on Paper and Purpur. -->
        <profile>
            <id>paper</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <server.api.groupId>io.papermc.paper</server.api.groupId>
                <server.api.artifactId>paper-api</server.api.artifactId>
                <server.api.version>${paper-api.version}</server.api.version>
                <smpplugin.flavor>paper</smpplugin.flavor>
            </properties>
        </profile>

        <!-- mvn package -Pspigot: Spigot API. Use this jar on Spigot and CraftBukkit. -->
        <profile>
            <id>spigot</id>
            <properties>
                <server.api.groupId>org.spigotmc</server.api.groupId>
                <server.api.artifactId>spigot-api</server.api.artifactId>
                <server.api.version>${spigot-api.version}</server.api.version>
                <smpplugin.flavor>spigot</smpplugin.flavor>
            </properties>
            <build>
                <plugins>
                    <!--
                      The dialog screens (com.bx.smpPlugin.dialogs) use the Paper dialog API, which Spigot
                      does not have, so the Spigot jar is built without them and always uses chest menus.
                      Code outside that package reaches dialogs only through utils.DialogGateway.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>com/bx/smpPlugin/dialogs/**</exclude>
                            </excludes>
                            <testExcludes>
                                <testExclude>com/bx/smpPlugin/dialogs/**</testExclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          mvn clean compile -Ppaper,api-latest: compile against the newest supported API (26.3, Java 25) to
          check that nothing the plugin uses was removed. Not for release jars.
        -->
        <profile>
            <id>api-latest</id>
            <properties>
                <java.version>25</java.version>
                <paper-api.version>26.3.build.157-beta</paper-api.version>
                <spigot-api.version>26.3-R0.1-SNAPSHOT</spigot-api.version>
            </properties>
        </profile>

    </profiles>


    <!-- ========================================================= -->
    <!-- BUILD                                                     -->
    <!-- ========================================================= -->

    <build>

        <defaultGoal>clean package</defaultGoal>

        <finalName>SmpPlugin-${project.version}-${smpplugin.flavor}</finalName>

        <sourceDirectory>src/main/java</sourceDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>


        <plugins>

            <!-- ================================================= -->
            <!-- COMPILER                                          -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>


            <!-- ================================================= -->
            <!-- SUREFIRE                                           -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>


            <!-- ================================================= -->
            <!-- SHADE                                              -->
            <!-- ================================================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>

                <!-- Shade rewrites bytecode with ASM; Java 25 class files (major 69) need a recent ASM. -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.10.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.10.1</version>
                    </dependency>
                </dependencies>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>

                    <!--
                        Do NOT generate dependency-reduced-pom.xml.
                        The generated file was stale in your project.
                    -->
                    <createDependencyReducedPom>false</createDependencyReducedPom>

                    <relocations>

                        <!-- SQLite -->
                        <relocation>
                            <pattern>org.xerial</pattern>
                            <shadedPattern>com.bx.smpplugin.libs.xerial</shadedPattern>
                        </relocation>

                        <!-- Redis -->
                        <relocation>
                            <pattern>redis.clients</pattern>
                            <shadedPattern>com.bx.smpplugin.libs.redis.clients</shadedPattern>
                        </relocation>

                        <!-- Commons Pool -->
                        <relocation>
                            <pattern>org.apache.commons.pool2</pattern>
                            <shadedPattern>com.bx.smpplugin.libs.commons.pool2</shadedPattern>
                        </relocation>

                    </relocations>

                    <filters>

                        <filter>
                            <artifact>*:*</artifact>

                            <excludes>
                                <exclude>META-INF/versions/**</exclude>
                            </excludes>

                        </filter>

                    </filters>

                </configuration>
            </plugin>

        </plugins>

    </build>

</project>